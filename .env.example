# Export these in your shell / Codex MCP environment (not loaded automatically).
# SEC_USER_AGENT=YourName contact@example.com
# FINANCE_CODEX_BIN=codex
# FINANCE_CODEX_MODEL=<optional override; default gpt-6-sol>
# FINANCE_PYTHON=<absolute path to an environment with requirements.txt installed>
# FINANCE_UV=<absolute path to local uv executable; auto-detected by default>
# FINANCE_PYTHON_VERSION=3.12 # only used when creating the uv environment
# UV_CONFIG_FILE=<absolute path to your uv.toml; optional>
# FINANCE_PORT=3205
# FINANCE_WEB_AUTOSTART=0 # optional: disable webpage autostart when MCP loads
# FINANCE_LAN=0 # optional: disable automatic physical Ethernet IPv4 access
